<Window x:Class="QUANLYTUYENSINH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QUANLYTUYENSINH"
        mc:Ignorable="d"
        Title="Nhâp liệu tuyển sinh 2025" Height="450" Width="800">
	<Grid>
		<Label Content="Mã thí sinh" HorizontalAlignment="Left" Margin="18,30,0,0" VerticalAlignment="Top"/>
		<Label Content="Họ tên" HorizontalAlignment="Left" Margin="18,60,0,0" VerticalAlignment="Top"/>
		<Label Content="Ngày sinh" HorizontalAlignment="Left" Margin="18,90,0,0" VerticalAlignment="Top"/>
		<Label Content="Điểm thi" HorizontalAlignment="Left" Margin="18,120,0,0" VerticalAlignment="Top"/>
		<Label Content="Ngành học" HorizontalAlignment="Left" Margin="18,150,0,0" VerticalAlignment="Top"/>
		<TextBox  x:Name="txtMaTS" HorizontalAlignment="Left" Margin="92,37,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
		<TextBox  x:Name="txtHoTen" HorizontalAlignment="Left" Margin="92,67,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
		<TextBox  x:Name="txtDiemThi" HorizontalAlignment="Left" Margin="92,127,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
		<DatePicker x:Name="dpDate" HorizontalAlignment="Left" Margin="92,92,0,0" VerticalAlignment="Top" Width="120"/>
		<ComboBox x:Name="cbx_NganhHoc" HorizontalAlignment="Left" Margin="92,154,0,0" VerticalAlignment="Top" Width="120" >

		</ComboBox>
		<Button x:Name="btnThemTS" Content="Thêm TS" HorizontalAlignment="Left" Margin="18,200,0,0" VerticalAlignment="Top" Width="75" Click="btnThemTS_Click"/>
		<Button x:Name="btnXoa" Content="Xoá" HorizontalAlignment="Left" Margin="100,200,0,0" VerticalAlignment="Top" Width="75" Click="btnXoa_Click"/>
		<Button x:Name="btnCapNhat" Content="Cập nhật" HorizontalAlignment="Left" Margin="182,200,0,0" VerticalAlignment="Top" Width="75" Click="btnCapNhat_Click"/>
		<Label Content="Danh sách" HorizontalAlignment="Left" Margin="328,37,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
		<DataGrid x:Name="dtg_DS" Margin="334,63,59,157" SelectionChanged="dtg_DS_SelectionChanged" AutoGenerateColumns="False" >
			<DataGrid.Columns>
				<DataGridTextColumn Header="Mã Thí sinh" Binding="{Binding MaTS}"/>
				<DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}"/>
				<DataGridTextColumn Header="Ngày Sinh" Binding="{Binding NgaySinh, StringFormat=dd/MM/yyyy}"/>
				<DataGridTextColumn Header="Điểm Thi" Binding="{Binding DiemThi}"/>
				<DataGridTextColumn Header="Mã Ngành" Binding="{Binding MaNganh}"/>
				<DataGridTextColumn Header="Tên Ngành Học" Binding="{Binding NGANHHOC.TenNganh}"/>


			</DataGrid.Columns>
		</DataGrid>
		<TextBox x:Name="txtSearch" HorizontalAlignment="Left" Margin="18,259,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
		<Button x:Name="btn_Search"  Content="Search" HorizontalAlignment="Left" Margin="163,259,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.227,0.232" Click="btn_Search_Click"/>
	</Grid>
</Window>
